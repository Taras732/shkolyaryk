# ============ Локальні env-змінні (скопіюй у .env) ============
# Значення беруться з Supabase Dashboard → Project → Settings → API / Database.
#
# 🔐 Для команди secret'и керуються через SOPS+age (зашифровано в git):
#   secrets/dev.env → розшифрувати у .env одним зі скриптів:
#     Windows:  powershell -File scripts/load-env.ps1
#     bash:     bash scripts/load-env.sh
#   (потрібен age-ключ у ~/.config/sops/age/keys.txt або %APPDATA%\sops\age\keys.txt)
#
# Цей .env.example — лише перелік потрібних змінних. Реальні значення
# НЕ комітяться у відкритому вигляді (.env у .gitignore).

# --- Клієнт (Vite, потрапляє у браузерний бандл; лише публічні ключі) ---
VITE_SUPABASE_URL=https://your-dev-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-anon-key

# --- Сервер (міграції/адмін-скрипти; НЕ експонуються у клієнт) ---
SUPABASE_DB_URL=postgresql://postgres:password@host:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# «Що в завданні?» — адреса воркера worker/homework (wrangler deploy). Порожньо — сторінка каже «ще не підключено».
VITE_HOMEWORK_API=
